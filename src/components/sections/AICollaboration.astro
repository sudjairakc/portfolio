---
import {getContent} from "../../data/portfolio";

const t = getContent(Astro.currentLocale).ai;
---

<section id="ai" class="section reveal">
  <!-- Heading block -->
  <div class="max-w-3xl">
    <span class="eyebrow">
      <span
        class="inline-block h-1.5 w-1.5 rounded-full"
        style="background:linear-gradient(135deg,#0ea5e9,#d946ef);box-shadow:0 0 10px rgba(217,70,239,0.7);"
        aria-hidden="true"></span>
      {t.eyebrow}
    </span>
    <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">
      {t.headingPre}{" "}
      <span class="gradient-text">{t.headingEm}</span>
    </h2>
    <p class="mt-4 text-lg font-semibold sm:text-xl">{t.headline}</p>
    <p class="text-sub mt-3 text-base leading-relaxed">{t.intro}</p>
  </div>

  <!-- Stats -->
  <div class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {
      t.stats.map(s => (
        <div class="glass reveal p-5 text-center transition duration-300 hover:-translate-y-1">
          <div class="text-2xl font-bold tracking-tight sm:text-[1.65rem]">
            <span class="gradient-text">{s.value}</span>
          </div>
          <div class="text-sub mt-1.5 text-xs leading-snug">{s.label}</div>
        </div>
      ))
    }
  </div>

  <!-- Stack (vendor level — no version numbers to go stale) -->
  <div class="mt-8">
    <h3 class="eyebrow">{t.stackLabel}</h3>
    <div class="mt-4 flex flex-wrap gap-2.5">
      {t.stack.map(name => <span class="pill font-semibold">{name}</span>)}
    </div>
  </div>

  <!-- Practices -->
  <div class="mt-12">
    <h3 class="text-lg font-semibold tracking-tight">{t.practicesLabel}</h3>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        t.practices.map((item, i) => (
          <article
            class="glass reveal-left relative overflow-hidden p-6"
            style={`transition-delay:${i * 70}ms`}
          >
            <span
              class="pointer-events-none absolute inset-y-0 left-0 w-1"
              style="background:linear-gradient(to bottom,#8b5cf6,#0ea5e9);"
              aria-hidden="true"
            />
            <h4 class="text-[0.95rem] font-semibold leading-snug">
              {item.name}
            </h4>
            <p class="text-sub mt-2 text-[0.85rem] leading-relaxed">
              {item.desc}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Honesty note: what an outsider can and cannot inspect. -->
    <p
      class="text-sub mt-6 max-w-3xl border-l-2 border-slate-300 pl-4 text-sm leading-relaxed italic dark:border-slate-600"
    >
      {t.note}
    </p>
  </div>
</section>
