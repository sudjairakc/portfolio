---
import {getContent, socialMediaLinks} from "../../data/portfolio";

const t = getContent(Astro.currentLocale).contact;
---

<section id="contact" class="section reveal">
  <div class="relative isolate mx-auto max-w-3xl">
    <!-- Layered background glow -->
    <div
      class="pointer-events-none absolute -inset-10 -z-10 overflow-visible"
      aria-hidden="true"
    >
      <div
        class="blob blob-sky absolute left-1/4 top-0 h-64 w-64 -translate-x-1/2"
      >
      </div>
      <div
        class="blob blob-violet absolute left-1/2 top-10 h-72 w-72 -translate-x-1/2"
        style="animation-delay:-5s"
      >
      </div>
      <div
        class="blob blob-fuchsia absolute right-1/4 bottom-0 h-64 w-64 translate-x-1/2"
        style="animation-delay:-9s"
      >
      </div>
    </div>

    <div
      class="glass flex flex-col items-center text-center px-6 py-14 md:px-14 md:py-20"
    >
      <span class="eyebrow mb-4">{t.eyebrow}</span>
      <h2
        class="text-3xl md:text-5xl font-bold tracking-tight mb-5 leading-tight"
      >
        {t.headingPre}
        <span class="gradient-text">{t.headingEm}</span>
      </h2>
      <p class="text-sub text-base md:text-lg max-w-xl mb-8">
        {t.subtitle}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
        <a href={`mailto:${t.email}`} class="btn-gradient">
          {t.emailBtn}
        </a>
        <a
          href={socialMediaLinks.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          GitHub
        </a>
        <a
          href={socialMediaLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          LinkedIn
        </a>
      </div>

      {
        /* Phone is assembled client-side so naive scrapers get nothing
           useful out of the static HTML. */
        t.phone && (
          <button
            type="button"
            id="reveal-phone"
            class="pill font-semibold transition-colors hover:text-sky-500"
            data-p={btoa(t.phone)}
          >
            <i class="fas fa-phone text-[0.7rem]" aria-hidden="true" />
            {t.phoneLabel}
          </button>
        )
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById("reveal-phone");
    if (!btn) return;
    btn.addEventListener(
      "click",
      () => {
        const phone = atob(btn.dataset.p || "");
        const link = document.createElement("a");
        link.href = `tel:${phone.replace(/[^0-9+]/g, "")}`;
        link.className = btn.className;
        link.textContent = phone;
        btn.replaceWith(link);
      },
      {once: true}
    );
  })();
</script>
